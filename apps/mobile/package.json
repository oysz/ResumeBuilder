{
  "name": "@resume-builder/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "prestart": "node ./scripts/link-hoisted-modules.mjs",
    "start": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "release": "npx --yes eas-cli@latest build --platform all --profile production --non-interactive --wait",
    "release:android": "npx --yes eas-cli@latest build --platform android --profile production --non-interactive --wait",
    "release:ios": "npx --yes eas-cli@latest build --platform ios --profile production --non-interactive --wait",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@resume-builder/core": "file:../../packages/core",
    "@ungap/structured-clone": "^1.3.0",
    "expo": "~54.0.33",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~18.1.11",
    "expo-sharing": "~13.1.5",
    "expo-status-bar": "~3.0.9",
    "jotai": "^2.15.1",
    "react": "19.1.0",
    "react-native": "0.81.0",
    "react-native-get-random-values": "^1.11.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.17",
    "babel-preset-expo": "~54.0.10",
    "typescript": "~5.9.2"
  }
}
