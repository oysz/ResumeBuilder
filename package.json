{
  "name": "resume-builder-workspace",
  "private": true,
  "version": "1.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "desktop:dev": "npm run dev --workspace @resume-builder/desktop",
    "desktop:build": "npm run build --workspace @resume-builder/desktop",
    "desktop:electron:dev": "npm run electron:dev --workspace @resume-builder/desktop",
    "desktop:electron:build": "npm run electron:build --workspace @resume-builder/desktop",
    "mobile:start": "npm run start --workspace @resume-builder/mobile",
    "mobile:web": "npm run web --workspace @resume-builder/mobile",
    "mobile:typecheck": "npm run typecheck --workspace @resume-builder/mobile",
    "core:typecheck": "npm run typecheck --workspace @resume-builder/core",
    "test": "npm run test --workspace @resume-builder/core"
  }
}
